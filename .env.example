# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AzamPay API Configuration
AZAMPAY_CLIENT_ID="your_azampay_client_id"
AZAMPAY_CLIENT_SECRET="your_azampay_client_secret"
AZAMPAY_API_KEY="your_azampay_api_key"
AZAMPAY_APP_NAME="CLASSIC_NET"
AZAMPAY_ENV="sandbox" # sandbox or production
AZAMPAY_CALLBACK_URL="https://api.classicnet.example.com/api/payments/callback"
AZAMPAY_WEBHOOK_URL="https://api.classicnet.example.com/api/payments/webhook"

# MikroTik RouterOS Configuration
MIKROTIK_HOST="192.168.88.1"
MIKROTIK_PORT="8728" # 8728 for API, 8729 for SSL, or 80/443 for REST API RouterOS v7
MIKROTIK_USER="admin"
MIKROTIK_PASSWORD="your_router_password"
MIKROTIK_HOTSPOT_SERVER="hotspot1"
MIKROTIK_PROFILE_PREFIX="classicnet_"

# Database Configuration (MySQL)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="classicnet_user"
DB_PASSWORD="your_db_password"
DB_NAME="classicnet_db"

# Admin & Security Configuration
ADMIN_DEFAULT_EMAIL="admin@classicnet.tz"
ADMIN_DEFAULT_PASSWORD="ClassicNetAdmin2026!"
JWT_SECRET_KEY="replace_with_a_secure_random_key"
TOKEN_EXPIRE_HOURS="24"

# Support Information
SUPPORT_PHONE="0618781830"
SUPPORT_EMAIL="jacksonribent53@gmail.com"

